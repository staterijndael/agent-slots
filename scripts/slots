#!/bin/sh
# Runs this checkout's agent_slots with python3 from PATH (3.9 or newer, no dependencies). Works through a symlink.
here=$(python3 -c 'import os, sys; print(os.path.dirname(os.path.dirname(os.path.realpath(sys.argv[1]))))' "$0")
PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m agent_slots "$@"
